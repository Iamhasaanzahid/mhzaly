# mhzaly — Cloudflare Pages security + performance headers
# Scale note: HTML shells are edge-cached (60s browser / 10min CDN) and every
# asset is versioned (?v=<sha>) + immutable for one year, so a returning
# visitor costs ZERO origin requests even at millions of concurrent users.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://mhzaly-api.mhzaly.workers.dev; manifest-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), usb=(), xr-spatial-tracking=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

# App shell — served from the CDN edge, revalidated in the background.
/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400
  X-Frame-Options: DENY

/index.html
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

# Versioned assets (?v=) are immutable for one year — one origin hit, then free.
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate

# Private pages must never be cached anywhere.
/owner.html
  Cache-Control: no-store, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive

/verify.html
  Cache-Control: no-store, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive

/404.html
  Cache-Control: public, max-age=60, s-maxage=600
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Fingerprinting / source maps / backups must never be served
/*.map
  X-Robots-Tag: noindex, noarchive
  Cache-Control: no-store

/*.bak
  X-Robots-Tag: noindex, noarchive
  Cache-Control: no-store
