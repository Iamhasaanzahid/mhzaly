# Copy to .env.email (git-ignored) and fill in.
#   cp scripts/email.env.example .env.email
#   set -a; . ./.env.email; set +a
#
# Cloudflare API token: dash.cloudflare.com > My Profile > API Tokens
#   Template: "Edit zone DNS"  (Zone.DNS:Edit on mhzaly.com only)
CF_API_TOKEN=
# Optional — auto-detected from MAIL_DOMAIN when empty.
CF_ZONE_ID=

MAIL_DOMAIN=mhzaly.com

# From Zoho: Admin > Domains > mhzaly.com > Verification > TXT method
ZOHO_VERIFY=zoho-verification=zbXXXXXXXX.zmverify.zoho.com

# From Zoho: Admin > Email Authentication > DKIM > Zoho Mail > copy TXT value
ZOHO_DKIM=

# none | quarantine | reject   (start with none, tighten after a week)
DMARC_POLICY=none
DMARC_RUA=mailto:dmarc@mhzaly.com

# 1 = preview only, no writes
DRY_RUN=0
# 1 = delete MX records that do not belong to Zoho
FORCE=0
